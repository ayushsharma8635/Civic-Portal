{
  "name": "ComplaintMedia",
  "type": "object",
  "properties": {
    "complaint_id": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "photo",
        "video"
      ],
      "default": "photo"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "citizen",
        "before",
        "during",
        "after"
      ],
      "default": "citizen"
    },
    "uploaded_by": {
      "type": "string"
    }
  },
  "required": [
    "complaint_id",
    "media_type",
    "file_url"
  ]
}