{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "status_update",
        "remark",
        "system",
        "assignment"
      ],
      "default": "system"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "complaint_id": {
      "type": "string"
    },
    "officer_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "message"
  ]
}